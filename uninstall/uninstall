#!/bin/bash
# Wird als Benutzer "root" ausgefuehrt.
#
# LoxBerry uebergibt die ueblichen fuenf Argumente; gebraucht wird hier der
# Installationsordner. Bis 1.1.0 stand in der Schleife unten "$LBPLOG/$PDIR",
# aber $PDIR wurde NIE zugewiesen - der Pfad wurde damit zu "$LBPLOG//..."
# und traf nie etwas. Aufgefallen ist das nicht, weil der erste Pfad
# (/run/shm/apc_ups_ng.pid) im Normalfall zutrifft: apc_service.py legt die
# PID-Datei dort ab, solange /run/shm existiert. Nur wenn es das NICHT tut -
# und genau dafuer war der zweite Pfad gedacht -, lief das Beenden ins Leere.
PDIR="${3:-apc_ups_ng}"

# ---------- Die Wurzel: gelesen, nicht geraten ----------
# Bis 1.2.12 war BASE das fuenfte Argument oder LBHOMEDIR, ohne Pruefung: fehlten
# beide, rechnete das Skript mit Pfaden ab der Laufwerkswurzel
# (/bin/plugins/..., /log/plugins/...) und meldete nichts; ohne $5 fand es die
# Wurzel auch dann nicht, wenn es selbst darin lag. In WSL gemessen
# (Pruefung-APC-UPS-1.2.13, Faelle U4, U5). Der Installer legt dieses Skript
# als <Wurzel>/data/system/uninstall/<ordner> ab und uebergibt die Wurzel als
# fuenftes Argument; die Suche greift nur, wenn weder $5 noch LBHOMEDIR
# brauchbar sind. Wurzel ist, was config/plugins, data/plugins UND
# config/system/general.json traegt (Regeln/06). Ohne Wurzel: <WARNING>,
# nichts beenden, nichts entfernen, Rueckgabe 1.
apc_wurzel_suchen() {
    v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd -P)
    i=0
    while [ -n "$v" ] && [ "$v" != "/" ] && [ "$i" -lt 8 ]; do
        if [ -d "$v/config/plugins" ] && [ -d "$v/data/plugins" ] \
           && [ -f "$v/config/system/general.json" ]; then
            echo "$v"; return 0
        fi
        v=$(dirname "$v"); i=$((i + 1))
    done
    return 1
}
BASE="${5:-}"
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ] || [ ! -d "$BASE/data/plugins" ]; then
    if [ -n "${LBHOMEDIR:-}" ] && [ -d "$LBHOMEDIR/config/plugins" ] \
       && [ -d "$LBHOMEDIR/data/plugins" ]; then
        BASE="$LBHOMEDIR"
    else
        BASE=$(apc_wurzel_suchen) || BASE=""
    fi
fi
if [ -z "$BASE" ]; then
    echo "<WARNING> Es wurde keine LoxBerry-Wurzel gefunden: weder als fuenftes Argument"
    echo "<WARNING> noch in \$LBHOMEDIR, und oberhalb dieses Skripts traegt kein Verzeichnis"
    echo "<WARNING> config/plugins, data/plugins und config/system/general.json."
    echo "<WARNING> Es wurde kein Dienst beendet und nichts entfernt."
    exit 1
fi
LOGDIR="${LBPLOG:-$BASE/log/plugins}"

# Ist PID ein Dienst dieses Plugins? Argumentweise (Regeln/03): argv[0] ein
# Python, argv[1] genau das Skript - nicht nur der Dateiname, sonst traefe
# es auch einen Editor mit der Datei offen.
DIENST="$BASE/bin/plugins/$PDIR/apc_service.py"
apc_ist_dienst() {
    [ -r "/proc/$1/cmdline" ] || return 1
    tr '\0' '\n' 2>/dev/null < "/proc/$1/cmdline" | {
        IFS= read -r a0 || exit 1
        IFS= read -r a1 || exit 1
        case "${a0##*/}" in python|python3|python3.*) ;; *) exit 1 ;; esac
        [ "$a1" = "$2" ]
    }
}
apc_dienste_suchen() {
    for d in /proc/[0-9]*; do
        [ "$(stat -c %u "$d" 2>/dev/null)" = "$2" ] || continue
        apc_ist_dienst "${d#/proc/}" "$1" && echo "${d#/proc/}"
    done
    return 0
}

# Dienst punktgenau ueber die PID-Datei beenden, nicht ueber pkill -f:
# das haette jeden Prozess getroffen, in dessen Befehlszeile der Dateiname
# vorkommt - auch einen offenen Editor.
#
# Argumentweise gegengeprueft wird VOR dem ersten Signal. Bis 1.2.10 war nur
# das SIGKILL abgesichert, das SIGTERM davor nicht - und Prozessnummern
# werden wiederverwendet. In WSL gemessen (Pruefung-APC-UPS-1.2.10, Fall
# fremd_pid): ein fremder Vorgang, dessen Nummer in der PID-Datei stand, war
# nach der Deinstallation tot. Ein kill an den Falschen ist nicht
# rueckgaengig zu machen.
for PIDF in /run/shm/apc_ups_ng.pid "$LOGDIR/$PDIR/apc_ups_ng.pid"; do
    [ -f "$PIDF" ] || continue
    P=$(cat "$PIDF" 2>/dev/null)
    if [ -n "$P" ] && kill -0 "$P" 2>/dev/null && apc_ist_dienst "$P" "$DIENST"; then
        kill "$P" 2>/dev/null
        i=0
        while [ $i -lt 10 ] && kill -0 "$P" 2>/dev/null; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$P" 2>/dev/null && apc_ist_dienst "$P" "$DIENST"; then
            kill -9 "$P" 2>/dev/null
        fi
    elif [ -n "$P" ] && kill -0 "$P" 2>/dev/null; then
        echo "<INFO> Die Nummer $P aus $PIDF gehoert einem fremden Vorgang -"
        echo "<INFO> es wurde nichts beendet, die Datei wird entfernt."
    fi
    rm -f "$PIDF"
done

# Dazu jeder eigene Dienst OHNE PID-Datei - der liefe sonst nach der
# Deinstallation weiter und sendete nach MQTT. In WSL gemessen
# (Pruefung-APC-UPS-1.2.10, Fall uninstall). Nur Python mit genau diesem
# Skript, nur beim Benutzer des Dienstes (loxberry).
APC_UID=$(id -u loxberry 2>/dev/null || id -u)
WAISEN=$(apc_dienste_suchen "$DIENST" "$APC_UID")
if [ -n "$WAISEN" ]; then
    kill $WAISEN 2>/dev/null
    i=0
    while [ $i -lt 10 ] && [ -n "$(apc_dienste_suchen "$DIENST" "$APC_UID")" ]; do
        sleep 1
        i=$((i + 1))
    done
    REST=$(apc_dienste_suchen "$DIENST" "$APC_UID")
    [ -n "$REST" ] && kill -9 $REST 2>/dev/null
    echo "<INFO> Ein Dienst ohne PID-Datei lief und wurde beendet (PID $(echo $WAISEN))."
fi
rm -f /run/shm/apc_ups_ng_status.json /tmp/apc_ups_ng_status.json

# ---------- Behaltene MQTT-Themen der Linie abraeumen ----------
# Bis 1.2.12 blieben Zustand, Modell, Seriennummer und letztes Ereignis nach
# der Deinstallation im Broker stehen, und nach jedem Neustart von Broker
# oder Gateway bekam der Miniserver sie als frische Werte (in WSL gemessen,
# Pruefung-APC-UPS-1.2.13, Fall U1). Welche Themen, wie am Broker gefragt und
# nachgelesen wird: mqtt_leeren() in bin/apc_lesen.py. Erst NACH dem Beenden
# des Dienstes - sonst schriebe er die Zustaende gleich wieder hinein - und
# VOR dem Loeschen der Ordner: Konfiguration (Praefix) und bin/ sind hier
# noch da, der Installer loescht sie erst nach diesem Skript.
#
# Als loxberry, nicht als root: gebraucht wird nur Lesezugriff auf die
# Konfiguration und auf general.json. stdin geschlossen, damit su nie auf
# eine Eingabe wartet.
#
# 'timeout -k 5 60': ohne -k schickt timeout nach 60 s nur SIGTERM, und ein
# Programm, das es nicht annimmt, hielte die Deinstallation an, bis es von
# selbst endet (Befund aus Sprachsteuerung 0.11.10, dort ueber acht Stunden;
# Vorbild Weissware 0.9.34). Gemessen mit einem SIGTERM-festen Platzhalter
# (Pruefung-APC-UPS-1.2.13, Fall U3): nach 65 s ist Schluss, und der Abbruch
# steht als WARNING da.
APC_BIN="$BASE/bin/plugins/$PDIR"
APC_RC=0
if [ -f "$APC_BIN/apc_lesen.py" ] && command -v python3 >/dev/null 2>&1; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "$(printf '%q ' env PYTHONDONTWRITEBYTECODE=1 \
            "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" timeout -k 5 60 python3 \
            "$APC_BIN/apc_lesen.py" --mqtt-leeren)" < /dev/null 2>&1 || APC_RC=$?
    else
        env PYTHONDONTWRITEBYTECODE=1 "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" \
            timeout -k 5 60 python3 "$APC_BIN/apc_lesen.py" --mqtt-leeren \
            < /dev/null 2>&1 || APC_RC=$?
    fi
    case "$APC_RC" in
        0|1|2) ;;
        124) echo "<WARNING> MQTT: das Leeren der behaltenen Themen wurde nach 60 s abgebrochen - unter dem Praefix der Linie kann noch etwas im Broker stehen. Von Hand: mosquitto_pub -r -n -t <thema>" ;;
        137) echo "<WARNING> MQTT: das Leeren der behaltenen Themen reagierte nach 60 s nicht auf SIGTERM und wurde hart beendet (SIGKILL) - unter dem Praefix der Linie kann noch etwas im Broker stehen. Von Hand: mosquitto_pub -r -n -t <thema>" ;;
        *) echo "<WARNING> MQTT: das Leeren der behaltenen Themen endete unerwartet (Rueckgabe $APC_RC) - unter dem Praefix der Linie kann noch etwas im Broker stehen." ;;
    esac
else
    echo "<INFO> python3 oder $APC_BIN/apc_lesen.py fehlt - behaltene MQTT-Themen wurden nicht geleert."
fi

# apcupsd wird bewusst NICHT entfernt. Die Originalfassung rief hier
#   sudo apt-get remove apcupsd
# ohne -y auf - das haette auf die Rueckfrage gewartet und die
# Deinstallation haengen lassen. Ausserdem kann apcupsd von anderen Diensten
# mitbenutzt werden; ein Plugin sollte es nicht ungefragt abraeumen.
echo "<INFO> apcupsd bleibt installiert und laeuft weiter."
echo "<INFO> Wer es loswerden will: sudo apt-get remove -y apcupsd"


# ---------- Den Nachbarn der Sicherung wegraeumen ----------
# data/plugins/<ordner>.upgrade_sicherung liegt AUSSERHALB des Ordners, den
# LoxBerry beim Deinstallieren loescht - genau deshalb uebersteht er ein
# Update. Wer ihn hier nicht abraeumt, laesst Zugangsdaten liegen.
UN_FOLDER="${3:-}"
UN_BASE="$BASE"
if [ -n "$UN_FOLDER" ] && [ -n "$UN_BASE" ] && [ -d "$UN_BASE/data/plugins" ]; then
    rm -rf "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung" 2>/dev/null
    # Zwischenstaende aus preupgrade.sh (neu bauen, dann umbenennen);
    # sie bleiben nur liegen, wenn ein Lauf mittendrin endete.
    rm -rf "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung.neu" \
           "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung.alt" 2>/dev/null
    # Die Marke "Aktualisierung laeuft" aus preupgrade.sh. Bliebe sie nach
    # einem abgebrochenen Upgrade liegen, sperrte sie den Waechter einer
    # Neuinstallation bis zu einer Stunde.
    rm -f "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_laeuft" 2>/dev/null
    # Der Anhaltemerker des Knopfs "Dienst anhalten". Bliebe er liegen, bliebe
    # der Dienst einer Neuinstallation angehalten, ohne dass es jemand weiss.
    rm -f "$UN_BASE/data/plugins/$UN_FOLDER.angehalten" 2>/dev/null
fi

# ---------- Die Zweitschrift neben dem Konfigordner wegraeumen ----------
# preupgrade.sh legt config/plugins/<ordner>.backup.apc_ups_ng.cfg an. Die
# Datei liegt NEBEN dem Ordner, den LoxBerry beim Deinstallieren loescht,
# und bliebe deshalb liegen - mit dem Formulartoken darin.
# Regeln/06, Abschnitt "Deinstallation": "Es gibt ein Sicherungsverfahren,
# nicht zwei; jede Zweitschrift, die entsteht, steht in uninstall."
# In WSL gemessen (Pruefung-APC-UPS-1.2.10, Fall uninstall): bis 1.2.10 lag
# sie nach der Deinstallation noch da.
#
# Vor dem Loeschen ueberschrieben. Das ist auf Speicherkarte und eMMC KEIN
# sicheres Loeschen (der Flash-Controller entscheidet, wohin geschrieben
# wird; Regeln/06) - es ist der Unterschied zwischen "steht noch da" und
# "muss man suchen". Gemeldet wird erst, nachdem nachgesehen wurde.
UN_ZWEIT="$UN_BASE/config/plugins/$UN_FOLDER.backup.apc_ups_ng.cfg"
UN_HATTE=0
if [ -n "$UN_FOLDER" ] && [ -n "$UN_BASE" ] && [ -f "$UN_ZWEIT" ]; then
    UN_HATTE=1
    dd if=/dev/zero of="$UN_ZWEIT" bs=1 count="$(wc -c < "$UN_ZWEIT")" \
        conv=notrunc >/dev/null 2>&1
    rm -f "$UN_ZWEIT" 2>/dev/null
fi
# Der Zwischenstand aus preupgrade.sh (daneben schreiben, dann umbenennen)
# traegt denselben Inhalt; er bleibt nur nach einem abgebrochenen Lauf.
if [ -n "$UN_FOLDER" ] && [ -n "$UN_BASE" ] && [ -f "$UN_ZWEIT.neu" ]; then
    dd if=/dev/zero of="$UN_ZWEIT.neu" bs=1 count="$(wc -c < "$UN_ZWEIT.neu")" \
        conv=notrunc >/dev/null 2>&1
    rm -f "$UN_ZWEIT.neu" 2>/dev/null
fi
# Gemeldet wird nur, was wirklich geschehen ist, und erst nach dem
# Nachsehen. Ein "ist entfernt" ohne vorgefundene Datei behauptete eine
# Handlung, die es nicht gab - dieselbe Klasse wie die Erfolgsmeldung eines
# gescheiterten sed (Regeln/06, "Ein Hakenskript meldet nur, was es
# nachgelesen hat").
if [ "$UN_HATTE" = "1" ]; then
    if [ -e "$UN_ZWEIT" ]; then
        echo "<WARNING> Die Zweitschrift $UN_ZWEIT liess sich nicht entfernen."
        echo "<WARNING> Sie traegt den Formulartoken - bitte von Hand loeschen."
    else
        echo "<OK> Die Zweitschrift der Einstellungen ist entfernt."
    fi
fi
exit 0
