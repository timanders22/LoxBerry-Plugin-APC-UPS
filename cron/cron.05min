#!/bin/sh
#
# APC-UPS NG - Waechter, alle fuenf Minuten.
#
# Bis 1.1.6 gab es keinen. Stirbt der Dienst - etwa an einem unerwarteten
# Fehler oder weil ihn jemand versehentlich beendet hat -, lief er bis zum
# naechsten Neustart des Rechners nicht wieder an. Bei einem USV-Plugin
# heisst das: der naechste Stromausfall wird nicht gemeldet, und in Loxone
# sieht alles normal aus, weil virtuelle Eingaenge ihren letzten Wert
# behalten.
#
# Fuenf Minuten statt einer: der Dienst ist ein Dauerlaeufer, kein Cron-Job.
# Ein minuetlicher Anlauf brauchte nur Rechenzeit.
#
# Der Platzhalter in der Zeile DIENST= wird bei der Installation durch den
# bin-Ordner des Plugins ersetzt. Er steht deshalb NUR dort und nicht hier
# im Kommentar: der Installer ersetzt ihn ueberall, und danach stuende in
# dieser Datei ein fest verdrahteter Systempfad - genau danach sucht der
# Pluginpruefer, ohne den Zusammenhang zu lesen.
#
# NICHT vom eigenen Ablageort eine feste Zahl Ebenen aufwaerts rechnen:
# LoxBerry legt diese Datei unter <Wurzel>/system/cron/cron.05min/<plugin>
# ab, also drei Ebenen unter der Wurzel. Eine Rechnung mit ".." landet
# daneben, und der Waechter lauft dann ins Leere, ohne es zu sagen.
DIENST="REPLACELBPBINDIR/apc_service.py"

# Laeuft gerade eine Aktualisierung, startet der Waechter nichts. Die Marke
# legt preupgrade.sh neben den Datenordner, postupgrade.sh entfernt sie und
# startet den Dienst selbst. Ohne sie startete der Takt in der Luecke
# zwischen neuer Cron-Datei und postinstall.sh einen Dienst mit der
# Vorgabe-Konfiguration (in WSL gemessen, Pruefung-Upgradeluecke-2026-09-17).
# Gilt nur, solange sie juenger als eine Stunde ist: eine abgebrochene
# Installation darf den Waechter nicht fuer immer stilllegen. Eine
# unlesbare Marke gilt nicht.
MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$MARKE" ]; then
    SEIT=$(cat "$MARKE" 2>/dev/null)
    case "$SEIT" in ""|*[!0-9]*) SEIT=0 ;; esac
    # Die Uhr wird gemessen, nicht angenommen. Bis 1.2.10 stand hier
    # ALTER aus einer Kommandoersetzung mit date DIREKT in der Rechnung:
    # liefert "date" nichts - unter Last kann ein fork scheitern -, rechnet
    # die Schale mit einer leeren Zeichenkette, das Alter wird negativ, die
    # Bedingung faellt durch, und der Waechter startet mitten in der
    # Aktualisierung. In WSL gemessen (18.09.2026, Fall waechter_g3o, date
    # als stumme Attrappe): 1 Prozess statt 0. Ein Schutz faellt geschlossen
    # aus (CLAUDE.md §4) - ohne Uhr gilt die Marke. Dieselbe Stelle steht in
    # daemon/daemon.
    JETZT=$(date +%s 2>/dev/null)
    case "$JETZT" in ""|*[!0-9]*) JETZT="" ;; esac
    if [ -z "$JETZT" ]; then
        exit 0
    fi
    ALTER=$(( JETZT - SEIT ))
    # 300 s Vorlauf: bis fuenf Minuten "aus der Zukunft" ist eine
    # nachgestellte Uhr, kein Grund, die Sperre zu verwerfen. Bis 1.2.12 stand
    # hier -ge 0 (in WSL gemessen, Pruefung-APC-UPS-1.2.13, Fall M1: Marke
    # 120 s voraus, Dienst gestartet). Dieselbe Stelle steht in daemon/daemon.
    if [ "$ALTER" -ge -300 ] && [ "$ALTER" -lt 3600 ]; then
        exit 0
    fi
fi

# Ist PID ein Dienst dieses Plugins? Argumentweise (Regeln/03): argv[0] ein
# Python, argv[1] genau das Skript. Ein Editor mit der Datei offen wird so
# nie fuer den Dienst gehalten.
apc_ist_dienst() {
    [ -r "/proc/$1/cmdline" ] || return 1
    tr '\0' '\n' 2>/dev/null < "/proc/$1/cmdline" | {
        IFS= read -r a0 || exit 1
        IFS= read -r a1 || exit 1
        case "${a0##*/}" in python|python3|python3.*) ;; *) exit 1 ;; esac
        [ "$a1" = "$2" ]
    }
}

# Ist das Plugin ausgeschaltet, hat der Waechter nichts zu tun. Sonst
# startete er einen Dienst, den der Anwender bewusst angehalten hat - und
# ein Waechter, der gegen den Willen des Anwenders arbeitet, ist schlimmer
# als keiner.
CFG="REPLACELBPCONFIGDIR/apc_ups_ng.cfg"
if [ -f "$CFG" ] && grep -q '^enabled=0' "$CFG"; then
    exit 0
fi
# Ebenso, wenn der Dienst mit dem Knopf "Dienst anhalten" (Reiter Test)
# angehalten wurde: der Knopf legt diesen Merker NEBEN den Datenordner, "Dienst
# neu starten" nimmt ihn weg. Bis 1.2.12 gab es ihn nicht, und dieser Waechter
# startete einen angehaltenen Dienst binnen fuenf Minuten wieder (in WSL
# gemessen, Pruefung-APC-UPS-1.2.13, Fall S1). Neben dem Ordner, damit ein
# Update ihn nicht loescht (Regeln/06, Sollmerker; Bauart Zendure/Govee, hier
# als Anhaltemerker, weil der Waechter dieser Linie ab Werk startet).
if [ -f "REPLACELBPDATADIR.angehalten" ]; then
    exit 0
fi

# Fail loud statt still. Ein Waechter, der schweigend nichts tut, ist
# schlimmer als keiner.
if [ ! -x "$DIENST" ]; then
    MELDUNG="APC-UPS NG: der Waechter findet apc_service.py nicht - es wird nicht nachgestartet."
    command -v logger >/dev/null 2>&1 && logger -t apc_ups_ng "$MELDUNG"
    echo "$MELDUNG" >&2
    exit 1
fi

# Laeuft er schon? Punktgenau ueber die PID-Datei nachsehen, nicht ueber
# "pgrep -f apc_service.py": das traefe auch einen offenen Editor oder ein
# Sicherungsskript, das gerade den Ordner durchsucht.
PIDF=/run/shm/apc_ups_ng.pid
[ -f "$PIDF" ] || PIDF="REPLACELBPLOGDIR/apc_ups_ng.pid"
if [ -f "$PIDF" ]; then
    P=$(cat "$PIDF" 2>/dev/null)
    if [ -n "$P" ] && kill -0 "$P" 2>/dev/null && apc_ist_dienst "$P" "$DIENST"; then
        exit 0
    fi
fi

# Keine gueltige PID-Datei - laeuft trotzdem einer? Ohne diese Frage
# startete der Waechter neben einem Dienst, dessen PID-Datei fehlt, einen
# zweiten: die Dateisperre des Dienstes haengt an der Datei, und eine neu
# angelegte Datei ist nicht mehr gesperrt. In WSL gemessen
# (Pruefung-Upgradeluecke-2026-09-17, Befund B5): zwei Dienste. Gesucht wird
# nur Python mit genau diesem Skript, nur beim Benutzer des Dienstes.
# Beendet wird hier nichts: ein eben gestarteter Dienst hat seine PID-Datei
# vielleicht noch nicht geschrieben. Deshalb erst drei Sekunden warten und
# nur melden, wenn die Datei dann noch fehlt.
WER_UID=$(id -u loxberry 2>/dev/null || id -u)
for d in /proc/[0-9]*; do
    [ "$(stat -c %u "$d" 2>/dev/null)" = "$WER_UID" ] || continue
    if apc_ist_dienst "${d#/proc/}" "$DIENST"; then
        WAISE=${d#/proc/}
        sleep 3
        PIDF=/run/shm/apc_ups_ng.pid
        [ -f "$PIDF" ] || PIDF="REPLACELBPLOGDIR/apc_ups_ng.pid"
        P=$(cat "$PIDF" 2>/dev/null)
        if [ -n "$P" ] && kill -0 "$P" 2>/dev/null && apc_ist_dienst "$P" "$DIENST"; then
            exit 0
        fi
        MELDUNG="APC-UPS NG: der Dienst laeuft ohne PID-Datei (PID $WAISE) - es wird kein zweiter gestartet. Beendet wird er durch ein Update, die Deinstallation oder einen Neustart des Rechners."
        command -v logger >/dev/null 2>&1 && logger -t apc_ups_ng "$MELDUNG"
        exit 0
    fi
done

# Er laeuft nicht. Nachstarten - als loxberry, nicht als root: der Dienst
# fragt nur den laufenden apcupsd ueber das Netz ab und braucht keine
# Rootrechte.
#
# ALS WELCHER BENUTZER LAEUFT DIESES SKRIPT? Das ist die Frage, an der der
# Waechter bis 1.2.5 gescheitert ist - jedes Mal, seit es ihn gibt.
#
# Hier stand der Start unbedingt ueber einen Benutzerwechsel - und der
# setzt Rootrechte voraus. Der LoxBerry-Cron ruft die Dateien unter
# system/cron/cron.05min aber ALS loxberry auf; gemessen in
# /etc/cron.d/lbdefaults:
#     */5 * * * * loxberry cd / && for f in .../cron.05min/*; do ($f ... &); done
# Ein Benutzerwechsel verlangt dann ein Kennwort und endet mit
# "Authentication failure", Rueckgabewert 1.
#
# Der alte Aufruf steht hier bewusst NICHT im Wortlaut: ein Kommentar, der
# die falsche Form woertlich fuehrt, laesst jede Suche danach auf sich
# selbst anschlagen. Genau das ist beim Berichtigen passiert.
#
# Am 06.09.2026 am Geraet gemessen: der Waechter hat seit der Installation
# um 19:52 alle fuenf Minuten in den Systemlogger geschrieben
#     "APC-UPS NG: der Dienst liess sich nicht nachstarten"
# und der Dienst lief anderthalb Stunden lang nicht. Er hat also laut
# gemeldet, dass er scheitert - und trotzdem nie gestartet.
#
# Deshalb wird der Benutzer jetzt GEMESSEN, nicht angenommen.
MELDUNG="APC-UPS NG: der Dienst lief nicht mehr und wurde nachgestartet."
LOG="REPLACELBPLOGDIR/apc_ups_ng.log"
WER=$(id -un 2>/dev/null)

if [ "$WER" = "loxberry" ]; then
    nohup "$DIENST" >> "$LOG" 2>&1 &
elif [ "$(id -u 2>/dev/null)" = "0" ]; then
    su loxberry -c "nohup $DIENST >> $LOG 2>&1 &" >/dev/null 2>&1
else
    MELDUNG="APC-UPS NG: der Waechter laeuft als '$WER' - weder loxberry noch root. Es wird nicht nachgestartet."
    command -v logger >/dev/null 2>&1 && logger -t apc_ups_ng "$MELDUNG"
    echo "$MELDUNG" >&2
    exit 1
fi

# Die WIRKUNG pruefen, nicht den Rueckgabewert.
#
# "nohup ... &" endet immer mit 0 - es sagt nur, dass die Shell den Auftrag
# abgesetzt hat, nichts darueber, ob der Dienst hochkam. Die alte Fassung
# hat genau daraus ihren Erfolg abgeleitet. Deshalb: kurz warten und
# nachsehen, ob wirklich einer laeuft.
sleep 3
PIDF=/run/shm/apc_ups_ng.pid
[ -f "$PIDF" ] || PIDF="REPLACELBPLOGDIR/apc_ups_ng.pid"
NEU=$(cat "$PIDF" 2>/dev/null)
if [ -n "$NEU" ] && kill -0 "$NEU" 2>/dev/null && apc_ist_dienst "$NEU" "$DIENST"; then
    command -v logger >/dev/null 2>&1 && logger -t apc_ups_ng "$MELDUNG (PID $NEU)"
    exit 0
fi

MELDUNG="APC-UPS NG: der Dienst liess sich nicht nachstarten - siehe Reiter Logdateien."
command -v logger >/dev/null 2>&1 && logger -t apc_ups_ng "$MELDUNG"
echo "$MELDUNG" >&2
exit 1
