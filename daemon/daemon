#!/bin/bash
# Wird beim Systemstart als Benutzer "root" ausgefuehrt.
# LoxBerry benennt diese Datei bei der Installation in NAME um.
#
# Die Originalfassung tat hier deutlich mehr - und deutlich Riskanteres:
# sie loeschte Dateien in /etc/apcupsd und ersetzte sie durch Symlinks in den
# Plugin-Ordner, schrieb mit sed in /etc/init.d/apcupsd und
# /etc/default/apcupsd herum und rief "/etc/init.d/apcupsd restart" auf.
# Das ist auf einem systemd-System weder noetig noch ungefaehrlich: geht bei
# der Deinstallation etwas schief, bleibt apcupsd mit toten Symlinks zurueck.
#
# Diese Fassung fasst die Systemkonfiguration nicht an. apcupsd wird als
# ganz normaler Dienst benutzt; das Plugin liest nur mit.

pluginname=REPLACELBPPLUGINDIR
pluginbindir=REPLACELBPBINDIR
logdir=REPLACELBPLOGDIR
log=$logdir/apc_ups_ng.log

if [ -x /usr/bin/logger ]; then
    /usr/bin/logger "loxberry-plugin-$pluginname - Starte APC-UPS NG"
fi

mkdir -p "$logdir" 2>/dev/null

# apcupsd selbst starten, falls es nicht laeuft. Ohne ihn antwortet
# apcaccess nicht.
if command -v systemctl >/dev/null 2>&1; then
    systemctl is-active --quiet apcupsd || systemctl start apcupsd 2>/dev/null
fi

# Der Ueberwachungsdienst braucht keine Rootrechte - apcaccess fragt den
# laufenden apcupsd ueber das Netz ab. Deshalb als loxberry starten.
su loxberry -c "nohup $pluginbindir/apc_service.py >> $log 2>&1 &" >/dev/null 2>&1

exit 0
